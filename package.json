{
  "name": "rtm-tasarim",
  "version": "1.0.0",
  "description": "RTM Tasarım kurumsal web sitesi ve Payload CMS uygulaması",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "content:check": "tsx scripts/content-snapshot.ts check",
    "content:export": "tsx scripts/content-snapshot.ts export",
    "content:import": "tsx scripts/content-snapshot.ts import",
    "content:verify": "tsx scripts/content-snapshot.ts verify",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:up": "docker compose up -d postgres",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "eval:assistant": "cross-env NODE_OPTIONS=--no-deprecation tsx --tsconfig tsconfig.json tests/assistant-evals/run.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "design-data:prune": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/prune-design-data.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/email-nodemailer": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.69.0",
    "next": "16.3.3",
    "pannellum": "2.5.7",
    "payload": "3.92.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-globe.gl": "2.38.0",
    "recharts": "3.8.0",
    "sharp": "0.35.4",
    "sonner": "1.7.4",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/pannellum": "2.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "postcss": "8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@11.28.6"
}
