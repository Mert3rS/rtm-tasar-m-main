DATABASE_URI=postgresql://rtm_dev:rtm_dev_password@localhost:5432/rtm_tasarim
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Upload limit in MiB, from 1 to 256; also configure the hosting proxy request limit.
MEDIA_MAX_UPLOAD_MB=32
# Optional persistent PUBLIC media storage. Configure in Vercel secret management.
# The existing owned store is 1qldjncltmptxwup.public.blob.vercel-storage.com.
# BLOB_READ_WRITE_TOKEN=
# Vercel server uploads have a 4.5 MB request limit (including multipart overhead).
# Direct browser uploads stay disabled to preserve server-side byte validation.
## Production canonical / social metadata: set only to the real HTTPS website origin.
# SITE_URL=https://your-approved-production-domain

# Optional SMTP; without it inquiries are stored and notifications remain disabled.
# SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# Approved recipient addresses, comma-separated; must include the CMS notification recipient.
# INQUIRY_NOTIFICATION_RECIPIENT_ALLOWLIST=
# Optional: cf-connecting-ip or x-real-ip. Only behind a proxy that strips/replaces that header.
# INQUIRY_CLIENT_IP_HEADER=
# Required by the daily Vercel retention job; use a long random value in production.
# CRON_SECRET=
